{
  "name": "local-you-todoo",
  "dockerComposeFile": "docker-compose.local.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace/you-todoo",
  "remoteUser": "${localEnv:USER}",
  "shutdownAction": "stopCompose",
  "customizations": {
    "jetbrains": {
      "backend": "PyCharm"
    }
  }
}
