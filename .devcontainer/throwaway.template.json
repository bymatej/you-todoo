{
  "name": "throwaway-you-todoo-__NAME__",
  "build": {
    "dockerfile": "../../Dockerfile",
    "context": "../../..",
    "args": {
      "USERNAME": "${localEnv:USER}",
      "USER_UID": "${localEnv:UID}",
      "USER_GID": "${localEnv:GID}",
      "DOCKER_GID": "${localEnv:DOCKER_GID}"
    }
  },
  "workspaceMount": "source=you-todoo-throwaway-__NAME__,target=/workspace,type=volume",
  "workspaceFolder": "/workspace/you-todoo",
  "remoteUser": "root",
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "postCreateCommand": "if [ ! -d /workspace/you-todoo/.git ]; then git clone https://github.com/bymatej/you-todoo.git /workspace/you-todoo; fi",
  "customizations": {
    "jetbrains": {
      "backend": "PyCharm"
    }
  }
}
